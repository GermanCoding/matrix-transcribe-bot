MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_USER_ID=@transcribe-bot:example.com
# Password-based login (used when MATRIX_ACCESS_TOKEN is not set)
MATRIX_PASSWORD=changeme
# Token-based login — set this instead of MATRIX_PASSWORD when using SSO / MAS.
# Obtain a token via your client, the device code flow, or any other non-password flow.
# MATRIX_ACCESS_TOKEN=
# Device ID associated with the access token above (auto-detected via /whoami if omitted)
# MATRIX_DEVICE_ID=
# Random secret used to encrypt the E2EE key database on disk.
# Generate once with: openssl rand -hex 32
PICKLE_KEY=change-this-to-a-long-random-secret
STORE_PATH=/app/store
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=es
WHISPER_MODEL_DIR=/app/models
WHISPER_CPU_THREADS=0
PYTHON_BIN=python
LOG_LEVEL=INFO
